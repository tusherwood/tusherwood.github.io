{% comment %}
  Full-bleed image band between the bio and the news on the about page. The
  image drifts slower than the page as you scroll past it. Enabled per page with
  `hero.image` (relative to assets/img/) and `hero.alt` in the front matter.
{% endcomment %}
{% assign hero_path = page.hero.image | prepend: 'assets/img/' %}
<div class="hero-band" role="img" aria-label="{{ page.hero.alt }}">
  <img class="hero-band-image" src="{{ hero_path | relative_url }}" alt="" loading="eager" decoding="async">
</div>
<script>
  (function () {
    var band = document.querySelector('.hero-band');
    var image = band && band.querySelector('.hero-band-image');
    if (!image || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var speed = 0.2; // how far the image lags the page; 0 = no drift
    var ticking = false;

    function update() {
      ticking = false;
      var rect = band.getBoundingClientRect();
      var viewport = window.innerHeight;
      if (rect.bottom < 0 || rect.top > viewport) return; // off screen, skip the work
      // 0 when the band is centred in the window, so the image rests where it was placed
      var offset = (viewport / 2 - (rect.top + rect.height / 2)) * speed;
      image.style.transform = 'translate(-50%, ' + offset + 'px)';
    }

    window.addEventListener(
      'scroll',
      function () {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    window.addEventListener('resize', update);
    update();
  })();
</script>
